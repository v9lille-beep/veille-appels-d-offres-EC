const B_API="https://boamp-datadila.opendatasoft.com/api/explore/v2.1/catalog/datasets/boamp/records";
function depVariants(d){d=d.trim().toUpperCase();var v=new Set([d]);var s=d.replace(/^0+/,"");if(s)v.add(s);if(/^[0-9]$/.test(s))v.add("0"+s);return [...v];}
async function fetchAll(baseUrl,dotId){
  let all=[],offset=0,total=0,capped=false;
  while(true){
    const rep=await fetch(baseUrl+"&limit=100&offset="+offset);
    if(dotId)setDot(dotId,rep.ok?"ok":"ko");
    if(!rep.ok)throw new Error("HTTP "+rep.status);
    const d=await rep.json();total=d.total_count||0;const res=d.results||[];
    all=all.concat(res);offset+=100;
    if(res.length<100||offset>=total)break;
    if(offset>=10000){capped=true;break;}
  }
  return {results:all,total,capped};
}
