function cGo(){
  const q=normal($("c-nom").value);if(!q){$("c-res").textContent="Tapez une commune.";return;}
  // recherche exacte puis partielle
  let key=Object.keys(DATA).find(k=>normal(DATA[k][0])===q);
  if(!key)key=Object.keys(DATA).find(k=>normal(DATA[k][0]).startsWith(q));
  if(!key){$("c-res").innerHTML='<span style="color:var(--mut)">Aucune commune « '+esc($("c-nom").value)+' » dans la base. Vérifiez l\'orthographe.</span>';return;}
  const [nom,deps]=DATA[key];const tot=deps.reduce((s,d)=>s+d[1],0);
  let sub=deps.map(d=>d[1]+" en "+d[0]).join(", ");
  $("c-res").innerHTML='<div style="padding:8px 0"><div style="font-size:15px;color:var(--fonce);font-weight:600">'+esc(nom)+'</div><div class="big">'+tot+'</div><div style="color:var(--mut);font-size:13px">défibrillateur(s) déclaré(s) sur le territoire'+(deps.length>1?" ("+sub+")":"")+'</div></div>';
}
$("b-go").onclick=bGo;$("b-csv").onclick=()=>csv(["Parution","Date limite","Acheteur","Departement","Type","Objet","Lien"],(bView.length?bView:bL).map(L=>[L.p,L.l,L.a,L.dep,L.ty,L.o,L.id?"https://www.boamp.fr/pages/avis/?q=idweb:"+L.id:""]),"appels_offres_dae.csv");
$("d-go").onclick=dGo;$("d-csv").onclick=()=>csv(["Notifie","Acheteur","Titulaire","Montant","DureeMois","Objet"],(dView.length?dView:dL).map(L=>[L.n,L.a,L.t,L.m,L.du,L.o]),"marches_dae_attribues.csv");
$("c-go").onclick=cGo;
["b-mots","b-deps"].forEach(id=>$(id).addEventListener("keydown",e=>{if(e.key==="Enter")bGo();}));
$("d-mots").addEventListener("keydown",e=>{if(e.key==="Enter")dGo();});
$("c-nom").addEventListener("keydown",e=>{if(e.key==="Enter")cGo();});
$("b-filtre").addEventListener("input",()=>{if(bL.length)renderB();});
$("b-open").addEventListener("change",()=>{if(bL.length)renderB();});
$("b-type").addEventListener("change",()=>{if(bL.length)renderB();});
$("b-since").addEventListener("change",()=>{if(bL.length)renderB();});
$("d-filtre").addEventListener("input",()=>{if(dL.length)renderD();});
wireSort("b",bSort,renderB);wireSort("d",dSort,renderD);
$("d-set").addEventListener("change",checkStatus);
checkStatus();
</script>
</body>
</html>
