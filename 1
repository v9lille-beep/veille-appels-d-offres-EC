var bSort={k:"p",dir:-1}, dSort={k:"n",dir:-1}, dView=[];
function cmpBy(k,dir,num){return function(a,b){var x=a[k]==null?"":a[k],y=b[k]==null?"":b[k];
  if(num){x=parseFloat(String(x).replace(",","."))||0;y=parseFloat(String(y).replace(",","."))||0;}
  else{x=String(x).toLowerCase();y=String(y).toLowerCase();}
  return x<y?-dir:x>y?dir:0;};}
function passe(L,q){if(!q)return true;q=q.toLowerCase();return Object.values(L).some(v=>String(v).toLowerCase().includes(q));}
function joursAvant(iso){if(!iso)return null;var t=new Date(iso+"T00:00:00");if(isNaN(t))return null;return Math.round((t-new Date())/86400000);}
